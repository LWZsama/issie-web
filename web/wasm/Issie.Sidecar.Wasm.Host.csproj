<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep interpreter mode until the current .NET 10 F# project graph can start its AOT output. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableDefaultWasmAssembliesToBundle>false</EnableDefaultWasmAssembliesToBundle>
    <WasmResolveAssembliesBeforeBuild>true</WasmResolveAssembliesBeforeBuild>
    <AssemblyName>issie-sidecar-wasm-host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <WasmAssembliesToBundle Include="$(TargetPath)" />
  </ItemGroup>
  <Target Name="AddWasmAssemblySearchPaths" BeforeTargets="PrepareInputsForWasmBuild">
    <ItemGroup>
      <WasmAssemblySearchPaths Include="$(TargetDir)" />
        <WasmAssemblySearchPaths Include="$(PublishDir)" Condition="'$(IsPublishing)' == 'true'" />
      <WasmAssemblySearchPaths Include="$(MicrosoftNetCoreAppRuntimePackRidLibTfmDir)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="Issie.Sidecar.Wasm.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="main.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="runtimeconfig.template.json" />
  </ItemGroup>
</Project>
