<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The desktop design codec discovers F# record and union constructors by reflection. -->
    <TrimMode>partial</TrimMode>
    <!-- Reference the desktop executable as a library. Its entry point never runs in the Worker. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>issie-sidecar-wasm-host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interop.cs" />
    <ProjectReference Include="..\..\src\Sidecar\Issie.Sidecar.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="main.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
